// by Nisan and Schocken, MIT Press.
/**
 * The complete address space of the Hack computer's memory,
 * including RAM and memory-mapped I/O. 
 * The chip facilitates read and write operations, as follows:
 *     Read:  out(t) = Memory[address(t)](t)
 *     Write: if load(t-1) then Memory[address(t-1)](t) = in(t-1)
 * In words: the chip always outputs the value stored at the memory 
 * location specified by address. If load=1, the in value is loaded 
 * into the memory location specified by address. This value becomes 
 * available through the out output from the next time step onward.
 * Address space rules:
 * Only the upper 16K+8K+1 words of the Memory chip are used. 
 * Access to address>0x6000 is invalid. Access to any address in 
 * the range 0x4000-0x5FFF results in accessing the screen memory 
 * map. Access to address 0x6000 results in accessing the keyboard 
 * memory map. The behavior in these addresses is described in the Screen
 * and Keyboard chip specifications given in the lectures and the book.
 */
CHIP Memory {
    IN in[16], load, address[15];
    OUT out[16];

    PARTS:
    // In this system, the "lower memory" will represent the RAM16K
    // and the "upper memory" will represent the Screen and Keyboard

    // First, we need to determine where we want to put the load bit
    DMux(in=load, sel=address[14], a=lwrLoad, b=uprLoad);
    
    // At this point, we have 14 bits to address the RAM16K,
    // since we used the most significant bit to determine which area of the memory to use
    RAM16K(in=in, load=lwrLoad, address=address[0..13], out=lwrOut);
    
    // Again, we have 14 bits to address the Screen and Keyboard.
    // We need one bit to distinguish which one to pick if the upper memory is selected
    // so we end up with 13 bits to address the screen.
    Screen(in=in, load=uprLoad, address=address[0..12], out=scrOut);

    // We will always need to probe the output of the Keyboard
    Keyboard(out=kbdOut);

    // Now, we pick which place from the upper memory to possibly output using the second-most significant bit
    Mux16(a=scrOut, b=kbdOut, sel=address[13], out=mxIO);

    // Using the selected upper memory output, we choose whether to output the upper or lower memory based on the most significant bit
    Mux16(a=lwrOut, b=mxIO, sel=address[14], out=out);
}